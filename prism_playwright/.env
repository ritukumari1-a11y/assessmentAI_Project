# Application URLs (legacy Prism tests)
BASE_URL=https://your-app-url.com
URL=https://api.practicesoftwaretesting.com

# QA Assessment - PracticeSoftwareTesting Toolshop
TOOLSHOP_BASE_URL=https://practicesoftwaretesting.com
TOOLSHOP_API_URL=https://api.practicesoftwaretesting.com

# Database (used by UI/utilities/databaseManager.js)
HOST=localhost
DBUSER=your_db_user
PASSWORD=your_db_password
DATABASE=your_db_name

# Xray integration (optional - only needed for post:test:xray scripts)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=
XRAY_PLAN_KEY=
XRAY_REPORT_XML=test-results/results.xml
